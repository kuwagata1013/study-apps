rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者かどうか: admins/{uid} ドキュメントが存在するユーザーのみ
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 管理者リスト: 自分のドキュメントの有無だけ確認できる。追加・削除は Firebase コンソールから行う
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // 学習ログ: 誰でも1件ずつ追加できる（ゲスト含む）。閲覧は管理者のみ。変更・削除は不可
    match /researchLogs/{logId} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isValidLog(request.resource.data);
    }

    function isValidLog(d) {
      return d.keys().hasOnly([
          'uid', 'participantId', 'deviceId', 'mode', 'subject',
          'durationSeconds', 'durationMinutes', 'startedAt', 'memo',
          'timerType', 'level', 'expGained', 'userAgent', 'dataset', 'createdAt'
        ])
        && d.keys().hasAll([
          'uid', 'participantId', 'deviceId', 'mode', 'subject',
          'durationSeconds', 'durationMinutes', 'startedAt', 'createdAt'
        ])
        // 自分のUIDか 'anonymous' 以外は名乗れない
        && (d.uid == 'anonymous' || (request.auth != null && d.uid == request.auth.uid))
        && d.participantId is string && d.participantId.matches('^[A-Za-z0-9_-]{0,32}$')
        && d.deviceId is string && d.deviceId.size() <= 64
        && d.mode in ['simple', 'gamified']
        && d.subject is string && d.subject.size() <= 100
        && d.durationSeconds is int && d.durationSeconds >= 0 && d.durationSeconds <= 86400
        && d.durationMinutes is int && d.durationMinutes >= 0 && d.durationMinutes <= 1440
        && d.startedAt is timestamp
        && (!('memo' in d) || (d.memo is string && d.memo.size() <= 2000))
        && (!('timerType' in d) || d.timerType in ['countup', 'countdown'])
        && (!('level' in d) || (d.level is int && d.level >= 1 && d.level <= 100000))
        && (!('expGained' in d) || (d.expGained is int && d.expGained >= 0 && d.expGained <= 1000000))
        && (!('userAgent' in d) || (d.userAgent is string && d.userAgent.size() <= 512))
        && (!('dataset' in d) || (d.dataset is int && d.dataset >= 1 && d.dataset <= 1000))
        && d.createdAt == request.time;
    }

    // 行動データ（起動・BGM・タップ・クエスト・タイマー操作）: 追加のみ。閲覧は管理者のみ
    match /researchEvents/{eventId} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isValidEvent(request.resource.data);
    }

    function isValidEvent(d) {
      return d.keys().hasOnly([
          'uid', 'participantId', 'deviceId', 'sessionId', 'mode', 'screen', 'type',
          'label', 'seconds', 'count', 'dataset', 'clientAt', 'createdAt'
        ])
        && d.keys().hasAll([
          'uid', 'participantId', 'deviceId', 'sessionId', 'mode', 'type', 'clientAt', 'createdAt'
        ])
        && (d.uid == 'anonymous' || (request.auth != null && d.uid == request.auth.uid))
        && d.participantId is string && d.participantId.matches('^[A-Za-z0-9_-]{0,32}$')
        && d.deviceId is string && d.deviceId.size() <= 64
        && d.sessionId is string && d.sessionId.size() <= 64
        && d.mode in ['start', 'simple', 'gamified', 'admin']
        && (!('screen' in d) || (d.screen is string && d.screen.size() <= 32))
        && d.type in [
          'app_launch', 'app_resume', 'bgm_select', 'bgm_play', 'bgm_stop', 'tap_summary',
          'quest_add', 'quest_complete', 'quest_uncomplete', 'quest_delete',
          'timer_start', 'timer_pause', 'timer_reset', 'timer_finish'
        ]
        && (!('label' in d) || (d.label is string && d.label.size() <= 100))
        && (!('seconds' in d) || (d.seconds is int && d.seconds >= 0 && d.seconds <= 864000))
        && (!('count' in d) || (d.count is int && d.count >= 0 && d.count <= 1000000))
        && (!('dataset' in d) || (d.dataset is int && d.dataset >= 1 && d.dataset <= 1000))
        && d.clientAt is timestamp
        && d.createdAt == request.time;
    }

    // 記録期間（データ1・データ2 …）の番号。誰でも読める（起動時に確認するため）。変更は管理者のみ
    match /settings/dataset {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['current', 'updatedAt'])
        && request.resource.data.current is int
        && request.resource.data.current >= 1
        && request.resource.data.current <= 1000
        && request.resource.data.updatedAt == request.time;
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
