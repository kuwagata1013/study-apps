rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者かどうか: admins/{uid} ドキュメントが存在するユーザーのみ
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 管理者リスト: 自分のドキュメントの有無は誰でも確認できる。一覧は管理者だけ（集計から管理者を除くため）
    // 追加・削除は Firebase コンソールから行う
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // 管理者のメールアドレス（管理画面を開いたときに本人が書く）。読めるのは管理者だけ
    match /adminProfiles/{uid} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'lastSeenAt'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if false;
    }

    // 学習ログ: 誰でも1件ずつ追加できる（ゲスト含む）。閲覧は管理者のみ。変更・削除は不可
    match /researchLogs/{logId} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isValidLog(request.resource.data);
    }

    function isValidLog(d) {
      return d.keys().hasOnly([
          'uid', 'participantId', 'deviceId', 'mode', 'subject',
          'durationSeconds', 'durationMinutes', 'startedAt', 'memo',
          'timerType', 'level', 'expGained', 'userAgent', 'dataset', 'createdAt'
        ])
        && d.keys().hasAll([
          'uid', 'participantId', 'deviceId', 'mode', 'subject',
          'durationSeconds', 'durationMinutes', 'startedAt', 'createdAt'
        ])
        // 自分のUIDか 'anonymous' 以外は名乗れない
        && (d.uid == 'anonymous' || (request.auth != null && d.uid == request.auth.uid))
        && d.participantId is string && d.participantId.matches('^[A-Za-z0-9_-]{0,32}$')
        && d.deviceId is string && d.deviceId.size() <= 64
        && d.mode in ['simple', 'gamified']
        && d.subject is string && d.subject.size() <= 100
        && d.durationSeconds is int && d.durationSeconds >= 0 && d.durationSeconds <= 86400
        && d.durationMinutes is int && d.durationMinutes >= 0 && d.durationMinutes <= 1440
        && d.startedAt is timestamp
        && (!('memo' in d) || (d.memo is string && d.memo.size() <= 2000))
        && (!('timerType' in d) || d.timerType in ['countup', 'countdown'])
        && (!('level' in d) || (d.level is int && d.level >= 1 && d.level <= 100000))
        && (!('expGained' in d) || (d.expGained is int && d.expGained >= 0 && d.expGained <= 1000000))
        && (!('userAgent' in d) || (d.userAgent is string && d.userAgent.size() <= 512))
        && (!('dataset' in d) || (d.dataset is int && d.dataset >= 1 && d.dataset <= 1000))
        && d.createdAt == request.time;
    }

    // 行動データ（起動・BGM・タップ・クエスト・タイマー操作）: 追加のみ。閲覧は管理者のみ
    match /researchEvents/{eventId} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isValidEvent(request.resource.data);
    }

    function isValidEvent(d) {
      return d.keys().hasOnly([
          'uid', 'participantId', 'deviceId', 'sessionId', 'mode', 'screen', 'type',
          'label', 'seconds', 'count', 'dataset', 'clientAt', 'createdAt'
        ])
        && d.keys().hasAll([
          'uid', 'participantId', 'deviceId', 'sessionId', 'mode', 'type', 'clientAt', 'createdAt'
        ])
        && (d.uid == 'anonymous' || (request.auth != null && d.uid == request.auth.uid))
        && d.participantId is string && d.participantId.matches('^[A-Za-z0-9_-]{0,32}$')
        && d.deviceId is string && d.deviceId.size() <= 64
        && d.sessionId is string && d.sessionId.size() <= 64
        && d.mode in ['start', 'simple', 'gamified', 'admin']
        && (!('screen' in d) || (d.screen is string && d.screen.size() <= 32))
        && d.type in [
          'app_launch', 'app_resume', 'bgm_select', 'bgm_play', 'bgm_stop', 'tap_summary',
          'quest_add', 'quest_complete', 'quest_uncomplete', 'quest_delete', 'quest_claim', 'scenery_change',
          'timer_start', 'timer_pause', 'timer_reset', 'timer_finish',
          'crystal_gain', 'crystal_use', 'focus_bonus'
        ]
        && (!('label' in d) || (d.label is string && d.label.size() <= 100))
        && (!('seconds' in d) || (d.seconds is int && d.seconds >= 0 && d.seconds <= 864000))
        && (!('count' in d) || (d.count is int && d.count >= 0 && d.count <= 1000000))
        && (!('dataset' in d) || (d.dataset is int && d.dataset >= 1 && d.dataset <= 1000))
        && d.clientAt is timestamp
        && d.createdAt == request.time;
    }

    // 記録期間（データ1・データ2 …）の番号。誰でも読める（起動時に確認するため）。変更は管理者のみ
    match /settings/dataset {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['current', 'updatedAt', 'names'])
        // データの名前（{ '1': '予備実験', ... }）
        && (!('names' in request.resource.data)
          || (request.resource.data.names is map && request.resource.data.names.size() <= 1000))
        && request.resource.data.current is int
        && request.resource.data.current >= 1
        && request.resource.data.current <= 1000
        && request.resource.data.updatedAt == request.time;
    }

    // ゲーム版デイリークエストの設定（1日に出す数・クリアボーナス・候補）。誰でも読める。変更は管理者のみ
    // 候補の中身はアプリ側で読むときに確かめて整える
    match /settings/quests {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['perDay', 'allClearExp', 'pool', 'updatedAt'])
        && request.resource.data.perDay is int
        && request.resource.data.perDay >= 1 && request.resource.data.perDay <= 6
        && request.resource.data.allClearExp is int
        && request.resource.data.allClearExp >= 0 && request.resource.data.allClearExp <= 1000
        && request.resource.data.pool is list
        && request.resource.data.pool.size() >= 1 && request.resource.data.pool.size() <= 40
        && request.resource.data.updatedAt == request.time;
    }

    // フレンド機能: 公開プロフィール（名前・レベル・称号・連続日数）
    // ログインした人がアカウントIDを指定して1件ずつ読める（一覧はできない）。書けるのは本人だけ
    match /players/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      // 管理者はパスワードの再発行（新しいアカウントへの引き継ぎ）とアカウントの削除のときに書く
      allow create, update: if ((request.auth != null && request.auth.uid == uid) || isAdmin())
        && isValidPlayer(request.resource.data);
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();

      // 自分のフレンド一覧（相手のアカウントIDをドキュメントIDにする）。読めるのは本人だけ
      // フレンドになるのは申請を承認したときだけ。承認した人が、自分の一覧と申請した人の一覧の両方に書く
      // 外すときはどちらからでも両方の一覧から消せる
      match /friends/{friendId} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow delete: if (request.auth != null && (request.auth.uid == uid || request.auth.uid == friendId)) || isAdmin();
        allow update: if false;
        allow create: if request.auth != null
          && friendId != uid
          && request.resource.data.keys().hasOnly(['addedAt'])
          && request.resource.data.addedAt == request.time
          && (
            // 管理者がパスワードの再発行で新しいアカウントへ引き継ぐ
            isAdmin()
            // 承認する人が、申請してきた人を自分の一覧に入れる
            || (request.auth.uid == uid
              && exists(/databases/$(database)/documents/friendRequests/$(friendId + '_' + uid)))
            // 承認する人が、申請してきた人の一覧に自分を入れる
            || (request.auth.uid == friendId
              && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendId)))
          );
      }
    }

    // 名前は必須（ログイン後に最初に決める）。レベル・称号・連続日数はゲーム版を使うと入る
    function isValidPlayer(d) {
      return d.keys().hasOnly(['name', 'level', 'title', 'streakDays', 'todayMinutes', 'todayKey', 'updatedAt'])
        && d.keys().hasAll(['name', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && (!('level' in d) || (d.level is int && d.level >= 1 && d.level <= 100000))
        && (!('title' in d) || (d.title is string && d.title.size() <= 40))
        && (!('streakDays' in d) || (d.streakDays is int && d.streakDays >= 0 && d.streakDays <= 100000))
        // その日の勉強時間（分）と日付（YYYY-MM-DD）
        && (!('todayMinutes' in d) || (d.todayMinutes is int && d.todayMinutes >= 0 && d.todayMinutes <= 1440))
        && (!('todayKey' in d) || (d.todayKey is string && d.todayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.updatedAt == request.time;
    }

    // プレイヤー名の登録（名前 → アカウントID）。名前は早い者勝ちで1人のもの
    // ログインした人が名前を指定して1件ずつ引ける（一覧はできない）。登録・解除は本人だけ。書き換えは不可
    // 管理者はパスワードの再発行で新しいアカウントに付け替え、アカウントの削除で外す
    match /playerNames/{key} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && ((request.resource.data.uid == request.auth.uid && resource == null) || isAdmin())
        && request.resource.data.keys().hasOnly(['uid', 'name', 'updatedAt'])
        && request.resource.data.uid is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // 発行済みの参加者ID（ドキュメントIDは小文字の参加者ID）。ここにないIDはアカウントに登録できない
    // gen はパスワードを再発行するたびに増える世代、deleted は管理者が削除したIDの印
    // ログイン前に確認するので1件ずつは誰でも読める。一覧と書き込みは管理者だけ
    match /issuedIds/{key} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['participantId', 'gen', 'deleted', 'updatedAt'])
        && request.resource.data.participantId is string
        && request.resource.data.participantId.matches('^[A-Za-z0-9_-]{1,32}$')
        && request.resource.data.participantId.lower() == key
        && request.resource.data.gen is int && request.resource.data.gen >= 1 && request.resource.data.gen <= 1000
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function isIssued(pid) {
      return exists(/databases/$(database)/documents/issuedIds/$(pid.lower()))
        && get(/databases/$(database)/documents/issuedIds/$(pid.lower())).data.deleted == false;
    }

    // アカウントに結び付けた研究参加者ID。読めるのは本人と管理者だけ
    // 本人は最初の1回だけ登録できる（変更できない）。付け替え・削除は管理者だけ
    match /accounts/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['participantId', 'createdAt'])
        && request.resource.data.participantId is string
        && request.resource.data.participantId.matches('^[A-Za-z0-9_-]{1,32}$')
        && isIssued(request.resource.data.participantId)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['participantId', 'createdAt', 'updatedAt'])
        && request.resource.data.participantId is string
        && request.resource.data.participantId.matches('^[A-Za-z0-9_-]{1,32}$')
        && isIssued(request.resource.data.participantId)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // フレンド申請（ドキュメントIDは「申請した人のID_相手のID」）
    // 読めるのは申請した人と相手だけ。承認・拒否・取り消しで消す。書き換えは不可
    match /friendRequests/{requestId} {
      allow read, delete: if isAdmin() || (request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid));
      allow update: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/players/$(request.resource.data.to))
        && !exists(/databases/$(database)/documents/players/$(request.auth.uid)/friends/$(request.resource.data.to));
    }

    // グループ（ドキュメントIDは招待コード）。コードを知っている人だけが1件ずつ開ける。一覧は自分が入っているものだけ
    match /groups/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && (request.auth.uid in resource.data.members || isAdmin());
      allow create: if request.auth != null
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && isValidGroup(request.resource.data)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/players/$(request.auth.uid));
      // 管理者はメンバーの追加・削除と、パスワードの再発行（新しいアカウントへの引き継ぎ）・アカウントの削除のときに書く
      allow update: if request.auth != null
        && isValidGroup(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (isAdmin()
          || isGroupJoin(request.auth.uid, resource.data, request.resource.data)
          || isGroupLeave(request.auth.uid, resource.data, request.resource.data)
          || isGroupOwnerEdit(request.auth.uid, resource.data, request.resource.data));
      // 解散
      allow delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }

    function isValidGroup(d) {
      return d.keys().hasOnly(['name', 'owner', 'members', 'createdAt'])
        && d.keys().hasAll(['name', 'owner', 'members', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.owner is string
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 20
        && d.members.toSet().size() == d.members.size()
        && d.owner in d.members;
    }
    // 参加：自分をメンバーに足すだけ
    function isGroupJoin(uid, before, after) {
      return after.diff(before).affectedKeys().hasOnly(['members'])
        && !(uid in before.members)
        && after.members.size() == before.members.size() + 1
        && after.members.hasAll(before.members)
        && uid in after.members
        && exists(/databases/$(database)/documents/players/$(uid));
    }
    // 退出：自分をメンバーから除くだけ。リーダーなら、残るメンバーにリーダーを渡す
    function isGroupLeave(uid, before, after) {
      return after.diff(before).affectedKeys().hasOnly(['members', 'owner'])
        && uid in before.members
        && !(uid in after.members)
        && after.members.size() == before.members.size() - 1
        && before.members.hasAll(after.members)
        && (after.owner == before.owner || before.owner == uid);
    }
    // リーダー：名前を変える、またはメンバーを1人外す
    function isGroupOwnerEdit(uid, before, after) {
      return before.owner == uid && after.owner == uid
        && (after.diff(before).affectedKeys().hasOnly(['name'])
          || (after.diff(before).affectedKeys().hasOnly(['members'])
            && after.members.size() == before.members.size() - 1
            && before.members.hasAll(after.members)));
    }

    // 学習の記録（ドキュメントIDは「アカウントID_データ番号」）。別の端末でも同じ記録を使うため。読み書きできるのは本人だけ
    // data は端末に保存しているゲーム版・シンプル版の値（キー → 文字列）。研究データの集計には使わない
    // 管理者はパスワードの再発行（新しいアカウントへの引き継ぎ）とアカウントの削除のときに読み書きする
    match /progress/{id} {
      allow get: if request.auth != null && (id.matches(request.auth.uid + '_[0-9]+') || isAdmin());
      allow list: if isAdmin();
      allow create, update: if request.auth != null
        && (request.resource.data.uid == request.auth.uid || isAdmin())
        && id == request.resource.data.uid + '_' + string(request.resource.data.dataset)
        && request.resource.data.keys().hasOnly(['uid', 'dataset', 'data', 'rev', 'savedAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'dataset', 'data', 'rev', 'savedAt', 'updatedAt'])
        && request.resource.data.uid is string
        && request.resource.data.dataset is int && request.resource.data.dataset >= 1 && request.resource.data.dataset <= 1000
        && request.resource.data.data is map && request.resource.data.data.size() <= 100
        && request.resource.data.rev is string && request.resource.data.rev.size() <= 40
        && request.resource.data.savedAt is int
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // お問い合わせ。ログインした本人が送る。読めるのは管理者だけ（対応状況とメモの変更・削除も管理者だけ）
    match /inquiries/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'uid', 'participantId', 'playerName', 'deviceId', 'mode', 'category', 'message', 'status', 'userAgent', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['uid', 'mode', 'category', 'message', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && (!('participantId' in request.resource.data) || (request.resource.data.participantId is string
          && request.resource.data.participantId.matches('^[A-Za-z0-9_-]{0,32}$')))
        && (!('playerName' in request.resource.data) || (request.resource.data.playerName is string
          && request.resource.data.playerName.size() <= 20))
        && (!('deviceId' in request.resource.data) || (request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() <= 64))
        && request.resource.data.mode in ['simple', 'gamified']
        && request.resource.data.category in ['bug', 'usage', 'request', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'open'
        && (!('userAgent' in request.resource.data) || (request.resource.data.userAgent is string
          && request.resource.data.userAgent.size() <= 512))
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminMemo', 'updatedAt'])
        && request.resource.data.status in ['open', 'done']
        && (!('adminMemo' in request.resource.data) || (request.resource.data.adminMemo is string
          && request.resource.data.adminMemo.size() <= 1000))
        && request.resource.data.updatedAt == request.time;
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
